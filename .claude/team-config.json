{
  "_comment": "Tamasha agent harness team configuration. Installed/updated into projects by krutyug-agent-harness install.sh (per-project prefix/name substituted at install). Agents read this file for team structure, quality gates, and workflow settings.",
  "project": {
    "name": "monorepo-boilerplate",
    "short_name": "TAM",
    "repo": "monorepo-boilerplate",
    "domain": "krutyug.live",
    "github_org": "krutyug",
    "company": "Tamasha"
  },
  "workflow": {
    "ticket_prefix": "TAM",
    "ticket_prefix_lower": "tam",
    "main_branch": "main",
    "tracker": "in-repo specs (specs/TAM-N-*.md)",
    "branch_format": "TAM-{number}-{description}",
    "commit_format": "type(scope): description [TAM-XXX]",
    "merge_strategy": "rebase-and-merge"
  },
  "agents": {
    "_comment": "The 11 SAFe agent roles. Each entry maps the role key to its config file, display name, category, and collapsibility (QAS and security-engineer are independence gates and never collapse).",
    "tdm": {
      "name": "Technical Delivery Manager",
      "config_file": ".claude/agents/tdm.md",
      "category": "planning",
      "description": "Reactive blocker resolution, spec status updates, evidence tracking",
      "collapsible": true,
      "primary_tools": ["specs", "markdown"],
      "exit_state": null
    },
    "bsa": {
      "name": "Business Systems Analyst",
      "config_file": ".claude/agents/bsa.md",
      "category": "planning",
      "description": "Requirements decomposition, acceptance criteria, testing strategy",
      "collapsible": true,
      "primary_tools": ["specs", "markdown"],
      "exit_state": null
    },
    "system-architect": {
      "name": "System Architect",
      "config_file": ".claude/agents/system-architect.md",
      "category": "planning",
      "description": "Pattern validation, Stage 1 PR review, migration approval, ADRs",
      "collapsible": false,
      "primary_tools": ["read", "grep", "adr-templates"],
      "exit_state": "Stage 1 Approved - Ready for ARCHitect"
    },
    "fe-developer": {
      "name": "Frontend Developer",
      "config_file": ".claude/agents/fe-developer.md",
      "category": "implementation",
      "description": "UI components, client-side logic, user interactions",
      "collapsible": true,
      "primary_tools": ["read", "write", "edit", "bash"],
      "exit_state": "Ready for QAS",
      "validation_command": "pnpm nx run-many -t typecheck && pnpm nx run-many -t lint --exclude=mobile && pnpm nx run-many -t build --exclude=mobile"
    },
    "be-developer": {
      "name": "Backend Developer",
      "config_file": ".claude/agents/be-developer.md",
      "category": "implementation",
      "description": "API routes, server logic, layered-module enforcement",
      "collapsible": true,
      "primary_tools": ["read", "write", "edit", "bash"],
      "exit_state": "Ready for QAS",
      "validation_command": "pnpm nx test api --configuration=integration"
    },
    "data-engineer": {
      "name": "Data Engineer",
      "config_file": ".claude/agents/data-engineer.md",
      "category": "implementation",
      "description": "Schema changes, migrations, database architecture",
      "collapsible": true,
      "primary_tools": ["prisma", "sql", "migration-tools"],
      "exit_state": "Ready for QAS",
      "validation_command": "pnpm prisma migrate deploy --schema apps/api/prisma/schema.prisma"
    },
    "qas": {
      "name": "Quality Assurance Specialist",
      "config_file": ".claude/agents/qas.md",
      "category": "quality",
      "description": "Execute testing strategy, validate ACs, iteration authority",
      "collapsible": false,
      "primary_tools": ["vitest", "flutter-test", "specs"],
      "exit_state": "Approved for RTE",
      "gate_owner": true
    },
    "security-engineer": {
      "name": "Security Engineer",
      "config_file": ".claude/agents/security-engineer.md",
      "category": "quality",
      "description": "Security validation, vulnerability assessment",
      "collapsible": false,
      "primary_tools": ["security-tools"],
      "exit_state": null,
      "gate_owner": true
    },
    "tech-writer": {
      "name": "Technical Writer",
      "config_file": ".claude/agents/tech-writer.md",
      "category": "quality",
      "description": "Documentation, guides, technical content",
      "collapsible": true,
      "primary_tools": ["read", "write", "edit", "grep", "glob", "bash"],
      "exit_state": null,
      "validation_command": "pnpm exec prettier --check '**/*.md'"
    },
    "rte": {
      "name": "Release Train Engineer",
      "config_file": ".claude/agents/rte.md",
      "category": "release",
      "description": "PR creation, CI/CD monitoring, no code, no merge",
      "collapsible": true,
      "primary_tools": ["git", "github-cli", "ci-tools"],
      "exit_state": "Ready for HITL Review"
    }
  },
  "review_stages": {
    "_comment": "Three-stage PR review pipeline. Each stage must pass before proceeding to the next.",
    "stage_1": {
      "name": "System Architect",
      "reviewer": "system-architect",
      "focus": "Technical and pattern validation",
      "blocking": true
    },
    "stage_2": {
      "name": "ARCHitect-in-CLI",
      "reviewer": "aashishagrawal",
      "focus": "Comprehensive architectural review",
      "blocking": true
    },
    "stage_3": {
      "name": "HITL",
      "reviewer": "aashishagrawal",
      "focus": "Final merge authority",
      "blocking": true
    }
  },
  "quality_gates": {
    "_comment": "Quality gate commands for projects built from monorepo-boilerplate; adjust per project if its targets diverge.",
    "lint": {
      "name": "Linting",
      "command": "pnpm nx run-many -t lint --exclude=mobile",
      "required": true,
      "stage": "pre-commit"
    },
    "type_check": {
      "name": "Type Checking",
      "command": "pnpm nx run-many -t typecheck",
      "required": true,
      "stage": "pre-commit"
    },
    "unit_tests": {
      "name": "Unit Tests",
      "command": "pnpm nx run-many -t test --exclude=mobile",
      "required": true,
      "stage": "pre-push"
    },
    "integration_tests": {
      "name": "Integration Tests",
      "command": "pnpm nx test api --configuration=integration",
      "required": true,
      "stage": "pre-push"
    },
    "e2e_tests": {
      "name": "End-to-End Tests",
      "command": "pnpm e2e:web",
      "required": true,
      "stage": "ci",
      "_comment": "Web E2E (Playwright) runs in CI; android E2E (pnpm e2e:android) needs an emulator \u2014 run before releases."
    },
    "security_scan": {
      "name": "Security Scan",
      "command": "pnpm audit --prod",
      "required": true,
      "stage": "ci"
    },
    "build": {
      "name": "Production Build",
      "command": "pnpm nx run-many -t build --exclude=mobile",
      "required": true,
      "stage": "ci"
    },
    "ci_validate": {
      "name": "Full CI Validation",
      "command": "pnpm verify",
      "required": true,
      "stage": "pre-pr",
      "_comment": "Runs all gates in sequence. Must pass before PR creation."
    }
  },
  "gates": {
    "_comment": "Blocking gates in the delivery pipeline. These correspond to the Gate Quick Reference in AGENTS.md.",
    "stop_the_line": {
      "owner": "implementer",
      "blocking": true,
      "description": "No acceptance criteria means no work begins"
    },
    "qas_gate": {
      "owner": "qas",
      "blocking": true,
      "description": "QAS must approve before RTE creates PR"
    },
    "stage_1_review": {
      "owner": "system-architect",
      "blocking": true,
      "description": "Pattern and architectural compliance check"
    },
    "stage_2_review": {
      "owner": "architect-in-cli",
      "blocking": true,
      "description": "Comprehensive architecture review"
    },
    "hitl_merge": {
      "owner": "aashishagrawal",
      "blocking": true,
      "description": "Final human merge authority"
    }
  },
  "paths": {
    "pattern_library": "patterns_library/",
    "specs": "specs/",
    "spec_templates": "specs_templates/",
    "agent_configs": ".claude/agents/",
    "skills": ".claude/skills/",
    "commands": ".claude/commands/",
    "agent_outputs": "docs/agent-outputs/",
    "adrs": "docs/adr/"
  },
  "agent_teams": {
    "_comment": "Agent Teams configuration (experimental). Requires CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 in settings.json.",
    "enabled": false,
    "env_var": "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS",
    "default_team_lead": "tdm",
    "default_teammate_mode": "in-process",
    "recommended_team_size": {
      "story": "2-3",
      "feature": "3-5",
      "epic": "5-8"
    },
    "gate_dependencies": {
      "_comment": "SAFe quality gates expressed as task dependencies. Blocked tasks cannot be claimed until dependencies complete.",
      "implementation": {
        "blocks": ["qas_validation"]
      },
      "qas_validation": {
        "blockedBy": ["implementation"],
        "blocks": ["rte_pr_creation"]
      },
      "rte_pr_creation": {
        "blockedBy": ["qas_validation"],
        "blocks": ["stage_1_review"]
      },
      "stage_1_review": {
        "blockedBy": ["rte_pr_creation"],
        "blocks": ["stage_2_review"]
      },
      "stage_2_review": {
        "blockedBy": ["stage_1_review"],
        "blocks": ["hitl_merge"]
      },
      "hitl_merge": {
        "blockedBy": ["stage_2_review"]
      }
    },
    "hooks": {
      "_comment": "Hook templates for quality gate enforcement. Customize commands for your project.",
      "TeammateIdle": {
        "description": "Validate teammate completed assigned tasks before going idle",
        "exit_code_2": "Sends feedback and keeps teammate working"
      },
      "TaskCompleted": {
        "description": "Validate task output meets acceptance criteria before completion",
        "exit_code_2": "Prevents completion and sends feedback"
      }
    }
  },
  "documentation": {
    "_comment": "Key documentation files that agents must read before specific types of work.",
    "mandatory_always": ["CLAUDE.md", "CONTRIBUTING.md", "AGENTS.md"],
    "mandatory_database": [
      "apps/api/prisma/schema.prisma",
      "apps/api/CLAUDE.md"
    ],
    "mandatory_security": ["apps/api/CLAUDE.md"],
    "mandatory_architecture": ["arch-boundaries.json", "docs/adr/"]
  }
}
