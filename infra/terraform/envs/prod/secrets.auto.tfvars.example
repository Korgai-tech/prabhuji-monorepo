# ==============================================================================
# envs/prod/secrets.auto.tfvars — PRODUCTION CREDENTIALS
#
# Copy this file to `secrets.auto.tfvars` (WITHOUT `.example`) and fill it in.
# That name is gitignored (`.gitignore`: *.auto.tfvars). NEVER commit it, never
# paste its contents into a ticket or a chat.
#
# Terraform auto-loads *.auto.tfvars — there is no -var-file flag to forget,
# which also means an apply run WITHOUT this file silently drops every value
# below to its default. The preconditions in main.tf exist to turn that silence
# into a failed plan. Read them if one fires.
#
# BACK THIS FILE UP somewhere durable (the team password manager) BEFORE the
# first apply. Several values below cannot be regenerated — see [PERM].
#
# Legend:
#   [GEN]    generate locally with the command shown
#   [VENDOR] copy from the vendor's dashboard
#   [PERM]   PERMANENT — changing it destroys data or access
# ==============================================================================

# --- [GEN] [PERM] Phone-hash pepper --------------------------------------------
# REQUIRED (min 32 chars). It has no default, so `terraform plan` for prod errors
# until this exists.
#
#   openssl rand -base64 36
#
# PERMANENT: mixed into every stored phone hash. Change it and EVERY user in
# prod's database becomes unreachable — they re-register as brand-new accounts
# and lose their subscription linkage. Never prod's stage value, and never
# regenerated after the first apply.
auth_otp_pepper = ""

# --- [GEN] Bootstrap admin (TAM-82) --------------------------------------------
# The ONLY way an admin account comes into being. Both or neither (env.ts fails
# the boot on a half-set pair); with neither, /cms serves but nobody can log in.
# Password min 16 — generate it, never choose it, because /auth/login is not rate
# limited.
#
#   openssl rand -base64 24
#
# Rotate later WITHOUT a terraform apply:
#   aws secretsmanager put-secret-value --secret-id app-prod-admin-bootstrap-password \
#     --secret-string '<new>' && aws ecs update-service --cluster app-prod \
#     --service app-prod-api --force-new-deployment
# (then update this file, or the next apply reverts it)
admin_bootstrap_email    = ""
admin_bootstrap_password = ""

# --- [VENDOR] MSG91 — LIVE SMS (costs money per message) -----------------------
# From the MSG91 dashboard. The template must be DLT-registered in India; there
# is no free-text path to a handset. `auth_otp_provider = "msg91"` is pinned in
# terraform.tfvars, so arming it without these keys is a total login outage —
# the otp_guard precondition fails the plan rather than letting that ship.
# Prod's credentials are prod's own; never reuse another environment's.
msg91_auth_key    = ""
msg91_template_id = ""
# Optional — most DLT templates carry their own sender. Leave "" unless the
# template expects one. A non-empty value creates a third secret.
msg91_sender_id = ""

# --- [VENDOR] TrustSignal — alternative real-SMS adapter -----------------------
# Only read when auth_otp_provider = "trustsignal". All FOUR or none: TrustSignal
# sends the message body on the wire, so the DLT text is a deploy input, and it
# must match the registered template character for character.
trustsignal_api_key          = ""
trustsignal_sender_id        = ""
trustsignal_template_id      = ""
trustsignal_message_template = ""

# --- [VENDOR] Cashfree — LIVE MONEY --------------------------------------------
# Dashboard -> Developers -> API Keys -> *** PRODUCTION tab, not Sandbox ***.
#
# BOTH ARE REQUIRED TOGETHER: modules/stack's `wire_cashfree` creates the
# secrets only when both are non-empty. One of two = no secrets at all = every
# api task crash-loops, with no old tasks left serving on a first apply. The
# payment_guard precondition catches this at plan time.
#
# There is no webhook secret: this account issues none, and callbacks are
# accepted unverified by design (the handler re-reads Cashfree's status API
# rather than trusting the body). Still create the endpoint
# https://<prod-domain>/payment/callbacks/cashfree under Developers -> Webhooks.
cashfree_client_id     = ""
cashfree_client_secret = ""

# --- [VENDOR] Decentro — UPI Autopay (the other real gateway) -------------------
# ALL FOUR ARE REQUIRED TOGETHER: modules/stack's `wire_decentro` creates the secrets
# only when every one is non-empty, because env.ts requires the whole set when
# payment_provider="decentro". A partial set = no secrets at all = every api task
# crash-loops. The payment_guard precondition catches it at plan time.
#
# From the Decentro dashboard, PRODUCTION keys (not staging). Register the callback
# URL as https://<prod-domain>/payment/callbacks/decentro.
#
# payment_callback_token is Decentro's callback auth — a static shared secret it sends
# in a header, minimum 32 characters. Cashfree has no equivalent (that account issues
# no signing key at all), which is why this field appears only in the Decentro set.
decentro_client_id     = ""
decentro_client_secret = ""
decentro_consumer_urn  = ""
payment_callback_token = ""

# --- [VENDOR] Razorpay ----------------------------------------------------------
# ALL FOUR ARE REQUIRED TOGETHER: modules/stack's `wire_razorpay` creates the secrets
# only when every one is non-empty, because env.ts requires the whole set when razorpay
# is the active provider. A partial set = no secrets at all = every api task
# crash-loops. The payment_guard precondition catches it at plan time.
#
# Keep them filled after switching AWAY from Razorpay too. There is no "enabled
# gateways" list to maintain — apps/api resolves every registered gateway lazily and
# reads each subscriber's gateway from mandates.provider — but a gateway whose
# credentials are gone still cannot bill its own rows.
#
# Dashboard -> Account & Settings -> API Keys, *** Live mode, not Test ***. The key
# secret is shown once at generation.
#
# razorpay_webhook_secret is Razorpay's callback auth — it HMACs the raw body, unlike
# Cashfree (no signing key) and unlike Decentro (a static replayable token). It must
# EQUAL the secret registered on the webhook at
# https://<prod-domain>/payment/callbacks/razorpay, or every delivery fails its
# signature check silently.
#
# Leaving these "" is the correct state until Razorpay is actually being adopted:
# no secret is created and nothing about the payment path changes.
razorpay_base_url       = ""
razorpay_key_id         = ""
razorpay_key_secret     = ""
razorpay_webhook_secret = ""

# --- [VENDOR] OpenAI — daily horoscope generation ------------------------------
# PRESENCE is the switch; there is no enable flag. Leave "" to ship without
# generated horoscopes (the daily endpoint 404s). Use a PROD-ONLY key with its
# own spend cap — do not reuse stage's.
openai_api_key = ""

# --- [VENDOR] ClickHouse Cloud — warehouse migrations + telemetry --------------
# Consumed by the pipeline's events:migrate step (CLICKHOUSE_ENV=prod -> the
# `prod` database, created if missing) and, with telemetry on, by the OTel
# collector sidecar. The same Cloud service as stage is acceptable — the database
# name differs — but a prod-only service user is better.
# Empty = the migrate step silently skips and telemetry cannot be armed.
clickhouse_host     = ""
clickhouse_password = ""

# --- [VENDOR] Docker Hub — authenticated image pulls in the CI gates -----------
# The pipeline's gates pull postgres:18-alpine (testcontainers + its ryuk
# reaper), floci/floci and clickhouse/clickhouse-server from Docker Hub.
# CodeBuild runs outside the VPC on shared AWS egress addresses, so an ANONYMOUS
# pull draws on a per-IP quota shared with every other tenant on that address —
# it fails the gates with HTTP 429 `toomanyrequests` and no app code involved.
# Set both to move the build onto this account's own quota.
# Use a Personal Access Token (Docker Hub -> Account Settings -> Personal access
# tokens) with PUBLIC REPO READ-ONLY scope, never the account password.
# Empty = pulls stay anonymous; the login step is skipped, not failed.
dockerhub_username = ""
dockerhub_token    = ""

# --- Observability: ClickStack collector sidecar --------------------------------
# enable_telemetry=true WITHOUT ClickHouse creds (and without an external
# endpoint) fails at PLAN time — modules/stack/services.tf's telemetry_guard.
# hyperdx_api_key may be any non-empty placeholder (the localhost OTLP hop does
# no client auth) but the SDK refuses to initialize without one.
#
# COST: arming this resizes BOTH the api and events tasks 512/1024 -> 1024/2048.
enable_telemetry               = false
hyperdx_api_key                = ""
clickstack_clickhouse_database = "otel_prod"

# --- Chatbot: RAGFlow (apps/api core/chat) -------------------------------------
# Paired with `ragflow_base_url` in terraform.tfvars, and BOTH HALVES must be
# set or chat is silently off — no plan error, no secret created, the env var
# simply absent from the task definition.
#
# Prod's terraform.tfvars leaves the origin empty on purpose (the feature was
# verified on stage only), so filling this in alone does nothing until the
# origin is set too.
ragflow_api_key = ""

# --- A/B testing: shared abtesting service (TAM-173) ----------------------------
# Paired with `abtest_base_url` (terraform.tfvars) — url-AND-key or nothing.
# Empty = chat + paywall variants resolve in-process (chat.buckets.ts /
# paywall.buckets.ts), the verified-safe default; a PROD runtime key must be
# issued on the shared platform (`pnpm --filter @svc/abtesting issue-key
# prabhuji prod-api`) and its digest registered in the platform's
# `.../abtesting/api-keys` secret before this value can work. Use the printed
# X-Tenant-Key line (tenant.keyId.<43-char base64url>), NOT the JSON entry's
# 64-hex secretHash — the digest cannot authenticate.
abtest_tenant_key = ""

# --- Generalized in-app modals: audience-campaign webhook (TAM-174) -------------
# Shared secret the audience-campaign service presents on POST
# /internal/modals/hooks. Unpaired — the route lives on this stack, so this key
# is the whole switch. Generate with `openssl rand -hex 32` and set the SAME
# value on the prod campaign messages' x-modal-hook-key header; prod's own
# value, never stage's. Empty leaves the route unregistered (a 404) in apps/api.
modal_hook_key = ""
