{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "node_modules/.cache/tsc/spec-out",
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/tsc/spec.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.integration.test.ts",
    "scripts/**/__tests__/**/*.test.ts",
    "src/**/__tests__/fixtures/**/*.json"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
