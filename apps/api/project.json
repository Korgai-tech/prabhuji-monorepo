{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "apps/api/dist",
        "format": [
          "esm"
        ],
        "bundle": true,
        "thirdParty": false,
        "external": [
          "@prisma/client"
        ],
        "main": "apps/api/src/index.ts",
        "additionalEntryPoints": [
          "apps/api/src/telemetry.ts",
          "apps/api/src/billing.ts",
          "apps/api/src/sync-deity-preferences.ts"
        ],
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": [
          "apps/api/src/assets"
        ],
        "declaration": false,
        "skipTypeCheck": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/api/dist/package.json",
        "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/apps/api/dist/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx watch --tsconfig apps/api/tsconfig.app.json apps/api/src/index.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node apps/api/dist/index.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "options": {
        "command": "tsc --build tsconfig.json --emitDeclarationOnly --force"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/api/src/**/*.ts",
          "apps/api/scripts/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project unit --config apps/api/vitest.config.ts"
      },
      "configurations": {
        "unit": {
          "command": "vitest run --project unit --config apps/api/vitest.config.ts"
        },
        "integration": {
          "command": "vitest run --project integration --config apps/api/vitest.config.ts"
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm openapi:emit"
      }
    },
    "check-openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm check:openapi"
      }
    },
    "sync-deity-preferences": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig apps/api/tsconfig.app.json apps/api/src/sync-deity-preferences.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": []
}
