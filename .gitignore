# local env files
.env
.env.local
.env.*.local
# sed / editor throwaway backups (e.g. `sed -i.bak`, `.env.old`) — always
# byproducts of a local iteration, never worth committing
.env*.bak*
.env*.old

# SDD ledger (local working files, not tracked)
.superpowers/

vitest.config.*.timestamp*
vite.config.*.timestamp*

# floci-aws local emulator data
/data/

# playwright
test-results/
playwright-report/

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# secret var files (e.g. ClickHouse Cloud password for the deploy pipeline) — never commit
*.auto.tfvars
# Agent design-inspection dumps (Figma JSON, throwaway scripts)
scratch/
specs
.codegraph