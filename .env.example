NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Interactive Swagger UI ("try it out") at http://localhost:3000/docs. Local/dev
# only — leave OFF in production. Built from the same route schemas as openapi.json.
ENABLE_API_DOCS=false
# TEMPORARY (remove before prod) — mounts POST /devtools/mark-pro, which flips a
# user to Pro by phone number (optional expiresAt). Off by default; turn on only
# in local/stage. NODE_ENV can't gate it (production in both stage and prod), so
# this flag is the switch.
ENABLE_DEV_TOOLS=false
# Exact browser origins allowed to call the api, comma-separated
# (e.g. https://app.krutyug.ai,http://localhost:4200). EMPTY reflects ANY origin,
# which is what local dev, the tests and the OpenAPI emitter need — and what an
# internet-facing ALB must never serve. The mobile app is not a browser and sends
# no Origin header, so it is unaffected either way; the admin CMS is the only
# browser client. Deployed envs set this from `cors_allowed_origins` in Terraform.
CORS_ALLOWED_ORIGINS=
# ⚠️ LOCAL IMAGE SMOKE TEST ONLY — do not set this anywhere else.
# env.ts hard-fails boot when AUTH_OTP_PROVIDER or PAYMENT_PROVIDER is `stub`
# under NODE_ENV=production: the OTP stub accepts the fixed code "1234" for EVERY
# phone number, and the payment stub auto-approves mandates and collects nothing.
# `pnpm deploy:local` runs the built image with NODE_ENV=production against floci,
# where no MSG91 or Cashfree credential exists, so it needs the opt-out — and it
# sets it itself in docker-compose.yml's `deploy` profile. It is deliberately NOT
# wired into modules/stack/services.tf, so reaching stage or prod takes a
# hand-edited task definition, not a forgotten variable.
ALLOW_STUB_PROVIDERS_IN_PRODUCTION=false
ENABLE_REDIS=false
# Discovery-feed rotation interval. UNSET = the production schedule (2h, i.e.
# every even hour IST). Set it only to watch several refreshes in a sitting —
# 300000 is a refresh every 5 minutes. Range: 60000 .. 86400000.
FEED_REFRESH_INTERVAL_MS=
REDIS_URL=redis://localhost:6379
# NOTE (TAM-80): the api fills EMPTY content tables on every start — no flag, no env
# var. Populated tables are never touched, so it's a no-op after the first run. To
# force-refresh content that already exists, run `pnpm seed` (all modules) or
# `pnpm --dir apps/api run seed:<module>` (one module).

# Auth OTP (apps/api core/otp module — TAM-43).
# AUTH_OTP_PEPPER is REQUIRED at boot (min 32 chars). Rotate via Secrets
# Manager in prod; NEVER commit a production value. Local dev value below is
# non-secret — it's fine for testcontainers + local.
AUTH_OTP_PEPPER=dev-otp-pepper-local-only-do-not-ship-32ch
# Which provider adapter to wire up. `stub` = local dev + integration tests
# (fixed OTP "1234"); `msg91` = real SMS. Resolved once at boot against the
# registry in core/otp/providers.ts, so switching an environment is this line
# plus a restart. Adding a provider: core/otp/add_new_otp_provider.md.
#
# EVERY non-stub value REQUIRES ENABLE_REDIS=true (+ REDIS_URL) and the boot
# fails loudly without it — the OTP session store is Redis-backed, and the rate
# limiter silently no-ops when Redis is off, which against a paid SMS gateway
# would leave an unmetered billable endpoint open to the internet.
AUTH_OTP_PROVIDER=stub

# Test numbers (QA + app-store-reviewer accounts). Comma-separated BARE national
# numbers, no country code — e.g. "9111111111,9222222222". A listed number skips
# SMS delivery entirely and its OTP is TEST_OTP instead of a random code. These
# numbers are unallocated, so a real SMS is billed and never arrives.
#
# LOGIN BYPASS — treat it as one:
#   * matching is EXACT against the whole national number, never a prefix;
#   * TEST_OTP is REQUIRED whenever TEST_NUMBERS is non-empty (env.ts fails the
#     boot otherwise) — a half-configured deploy must not fall back to a
#     guessable code;
#   * only delivery and code choice change. Expiry, attempt cap, one-shot burn
#     and rate limiting are the ordinary ones.
#   * every use logs `otp_test_number_used` at warn, with the number.
# Both empty (the default) disables the mechanism. On stage/prod TEST_OTP comes
# from Secrets Manager; TEST_NUMBERS is a plain task env var.
# Quote TEST_OTP wherever the format allows — an unquoted 0123 becomes 123.
# TAM-187: TEST_OTP is ALSO the code for test users an admin creates at
# /test-users in the CMS (User.isTestUser) — set it on any env that uses them.
TEST_NUMBERS=
TEST_OTP=

# MSG91 (used only when AUTH_OTP_PROVIDER=msg91). We generate, hash and verify
# the OTP ourselves; MSG91's Flow API is purely the delivery pipe, so expiry and
# attempt limits stay ours and behave identically on every provider.
# MSG91_AUTH_KEY + MSG91_TEMPLATE_ID are required together when the provider is
# armed. Get both from the MSG91 dashboard; NEVER commit real values (Secrets
# Manager on stage/prod).
MSG91_BASE_URL=https://control.msg91.com
MSG91_AUTH_KEY=
# The DLT-registered template the OTP rides in. India requires a pre-approved
# template — there is no free-text path to a real handset.
MSG91_TEMPLATE_ID=
# Optional: most templates bake the sender in, in which case MSG91 ignores this.
MSG91_SENDER_ID=
# The variable name the OTP is substituted into inside your DLT template
# (a template written with `##otp##` wants `otp` here).
MSG91_OTP_VAR=otp
# TAM-123 — the template variable carrying the Google SMS Retriever hash that
# makes Android auto-fill the OTP (template tail: `\n\n<##>{{otphash}}`).
MSG91_HASH_VAR=otphash
MSG91_TIMEOUT_MS=10000

# Bootstrap admin (apps/api core/auth — TAM-82). Provisions the FIRST admin user
# at boot; idempotent, so it's safe on every task start.
#
# THERE IS NO DEFAULT PASSWORD AND THERE NEVER WILL BE. Leave both empty and the
# boot path is skipped entirely: NO admin is created and NO /admin/* route is
# reachable by anyone. A missing secret produces no admin, not a weak admin.
# Never commit a value here — this file is the example, not the secret store.
#
# To provision the first admin (local):
#   1. generate a password:  openssl rand -base64 24
#   2. set both vars below in your own `.env` (min 16 chars; both or neither)
#   3. restart the api — the user is created with role=admin and a bcrypt hash
# On stage/prod both come from Secrets Manager, exactly like JWT_SECRET.
#
# Behaviour when set: user absent -> created as admin; user already exists ->
# role is ensured admin and the EXISTING PASSWORD IS NEVER TOUCHED (so rotating
# the bootstrap admin's password is a manual DB write today — there is no
# change-password endpoint yet; known gap, deferred).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Media storage (admin CMS uploads — TAM-83 infra / TAM-84 core/media) ---
# The admin panel presigns a PUT and the browser uploads straight to object
# storage; the api never touches the bytes. Locally that store is the floci-aws
# S3 emulator; on stage/prod it is a PRIVATE S3 bucket fronted by CloudFront.
# Authority: docs/ADMIN-CMS-ARCHITECTURE.md §A2/§A7; spec: specs/TAM-83-*.md.
#
# The bucket is created + CORS-configured automatically by the `floci-init`
# compose service on `docker compose up -d` (scripts/floci-init.sh). To point the
# browser PUT at a different admin origin: MEDIA_CORS_ALLOWED_ORIGINS=... (comma
# separated; Terraform's media_cors_allowed_origins is the stage/prod equivalent).
#
# LOCAL IS LOCAL: an asset uploaded to floci is reachable only from this machine.
# It does not exist on stage, and a phone cannot fetch http://localhost:4566/...
# Content is entered per environment; stage content is entered against stage.
MEDIA_BUCKET=app-local-media
# Base URL every stored media URL is built from and validated against. Locally
# the floci endpoint; on stage/prod ALWAYS the CloudFront domain (terraform
# output media_public_base_url) and NEVER the *.s3.amazonaws.com origin.
MEDIA_PUBLIC_BASE_URL=http://localhost:4566/app-local-media
# DEV-ONLY CARVE-OUT. `mediaUrl` is https-only (apps/api/src/shared/schemas/media.ts)
# and floci is http-only, so a locally-uploaded asset would fail response
# serialization. When true, http:// is additionally accepted on localhost /
# 127.0.0.1 / 10.0.2.2 (the Android emulator's host alias) origins ONLY.
# Default false. NEVER set in Terraform — its absence IS its production value,
# and the api hard-fails boot if it is true while NODE_ENV=production.
MEDIA_ALLOW_INSECURE_URLS=true
# TAM-267 upload optimizer. When true, heavy video/audio uploads (status video,
# paywall hero, banners, aarti/book audio) are PUT to incoming/<key>; a Lambda
# compresses them into the final key and the CMS polls /admin/media/status
# ("Optimising…") before saving. Keep it OFF locally — floci has no Lambda, so
# nothing would ever write the final key. On stage/prod Terraform's
# enable_media_upload_optimizer sets it together with the Lambda. Default false.
MEDIA_OPTIMIZE_UPLOADS=false

# Domain-event bus (apps/api). Off = in-process transport (zero infra, the
# default/dev). On = Kafka/MSK; locally point at floci-aws MSK / a redpanda
# broker. Topics are per-aggregate (e.g. "user"); KAFKA_TOPIC_PREFIX prefixes
# them to isolate envs sharing one cluster (e.g. "staging" -> "staging.user").
ENABLE_KAFKA=false
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_PREFIX=staging
# Broker auth: "none" = plaintext (local redpanda). Production MSK uses "aws-iam"
# (TLS + SASL/IAM, token signed from the task role — set AWS_REGION too):
# KAFKA_SASL=none

# --- apps/events (click-events collector — HTTP, Amplitude V2 at /2/httpapi) ---
EVENTS_PORT=3001
EVENTS_API_KEY=change-me-to-a-long-random-string
# DEBUG: log every incoming raw payload (api_key redacted) to inspect the SDK wire
# shape (client_upload_time / event_id / sent_at / time). Off by default; never in prod.
EVENTS_LOG_RAW_PAYLOAD=false
# Kinesis sink is opt-in; against the local floci-aws emulator also set:
#   AWS_ENDPOINT_URL=http://localhost:4566  AWS_REGION=ap-south-1
#   AWS_ACCESS_KEY_ID=test                  AWS_SECRET_ACCESS_KEY=test
ENABLE_KINESIS=false
# KINESIS_STREAM_NAME=events
# Forward every accepted batch on to another Amplitude V2 collector, as-is — how a
# RELEASED app is re-pointed without a store release (its serverUrl is baked in).
# Deployed envs set these to the same destination apps/api posts to below
# (ANALYTICS_EVENTS_URL + that collector's OWN key, not EVENTS_API_KEY).
# Fire-and-forget: a dead destination never changes the 200 the SDK sees.
# Same two names apps/api uses below — one destination, one key, both producers.
# ANALYTICS_EVENTS_URL=https://api-monorepo-common-staging.krutyug.ai/events/2/httpapi
# ANALYTICS_EVENTS_API_KEY=<the destination collector's api key>

# --- apps/api as an events PRODUCER (server-side payment analytics, TAM-145) ---
# The API posts payment/subscription events to the collector above, so the
# warehouse sees the funnel the client cannot: mandate registered, approval
# landed, renewal settled, lapsed. The key is the SAME EVENTS_API_KEY.
# Best-effort — a dead collector never changes a payment outcome.
ANALYTICS_EVENTS_ENABLED=false
# ANALYTICS_EVENTS_URL=http://localhost:3001/2/httpapi
# ANALYTICS_EVENTS_API_KEY=change-me-to-a-long-random-string
ANALYTICS_EVENTS_TIMEOUT_MS=5000

# --- apps/api A/B testing (shared abtesting service, TAM-173) ---
# Chat + paywall variants ask the shared platform's abtesting service FIRST when
# both halves are set. Unset (the default), or on ANY client failure, they fall
# back to the in-process bucket maps (chat.buckets.ts / paywall.buckets.ts), so
# leaving this off changes nothing. The base URL INCLUDES the service's route
# prefix (/abtesting behind the shared ALB); the client appends /evaluate and
# /bucket-space/subject/:id (the latter stamps bucket_id on bk_account_created;
# unset means that property ships as null). Both take the same RUNTIME key.
# ABTEST_BASE_URL=https://api-monorepo-common-staging.krutyug.ai/abtesting
# ABTEST_TENANT_KEY=<runtime key — pnpm --filter @svc/abtesting issue-key prabhuji>
# ABTEST_TIMEOUT_MS=1500

# --- apps/api app-landing experiments (TAM-258) ---
# When the landing experiments started. A user whose FIRST successful OTP verify
# predates this is excluded from BOTH arms — not counted as control, out of the
# experiment entirely. Unset (and unparseable) falls back to the placeholder in
# core/users/services/landing.constants.ts, never to "no gate".
# LANDING_EXPERIMENT_START_AT=2026-09-23T00:00:00.000Z

# --- apps/api generalized modals (TAM-174) ---
# Shared secret presented by the audience-campaign service on
# POST /internal/modals/hooks. Unset => the route is not registered.
# MODAL_HOOK_KEY=<generate with: openssl rand -hex 32>

# --- apps/events/db (analytics warehouse migrations — ClickHouse Cloud) ---
# Local needs nothing: `pnpm nx run events:migrate` boots the compose container
# (db `analytics`; override host ports via CLICKHOUSE_HTTP_PORT / CLICKHOUSE_TCP_PORT,
# and the container password via CLICKHOUSE_LOCAL_PASSWORD — default local-dev-only).
# staging/prod (`nx run events:migrate:staging|:prod`, databases `staging`/`prod`;
# or from apps/events: `CLICKHOUSE_ENV=staging|prod pnpm migrate`)
# need the ClickHouse Cloud service credentials (HTTPS interface, :8443):
# CLICKHOUSE_HOST=your-service.clickhouse.cloud
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-service-password

# --- Figma (agent design-context fallback) ---
# The agent prefers the Figma Desktop MCP server (localhost, no token, uses the
# logged-in Figma session). When the harness runs on a machine WITHOUT Figma
# Desktop (CI, remote/cloud dev env, another contributor's box), it falls back
# to the Figma REST API using this personal access token.
# Get one: Figma -> Settings -> Account -> Personal access tokens.
# Scopes needed: File content:read, Dev resources:read, Variables:read (Enterprise/Dev Mode plan only), Library assets:read.
# NEVER commit a real token — a live one WAS committed here and is burned; it
# must be revoked at Figma -> Settings -> Personal access tokens regardless of
# this file, because it is in git history. Rotate via Secrets Manager in CI.
FIGMA_TOKEN=


# --- Observability (apps/api + apps/events -> hosted ClickStack) ---
# OpenTelemetry traces + logs + metrics via the HyperDX SDK. Off = no SDK loaded.
# Point ENDPOINT at your hosted ClickStack OTLP collector (OTLP/HTTP, :4318).
# When ENABLE_TELEMETRY=true, BOTH the endpoint and HYPERDX_API_KEY are required
# (the SDK skips init without a key). In the deploy profile these flow into both
# the api and events containers.
ENABLE_TELEMETRY=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-clickstack-host:4318
# HYPERDX_API_KEY=your-ingestion-key

# --- Payments (apps/api core/payment — UPI Autopay mandates + recurring debits) ---
# `stub` is an in-memory provider that auto-approves shortly after registration,
# so the whole flow (register -> approve -> PDN -> debit -> entitlement) runs
# with no vendor credentials and no real UPI app — which matters because an
# Android emulator has no GPay/PhonePe to approve a mandate with. Default `stub`
# so a misconfigured deploy cannot accidentally move real money.
PAYMENT_PROVIDER=stub
# ...and ONLY that. There is no companion "enabled gateways" list: an existing
# mandate is notified, debited, polled, settled and revoked through the gateway
# named in its OWN row, and every gateway in the registry stays resolvable —
# its adapter is built lazily on the first row that needs it. So switching
# PAYMENT_PROVIDER moves new registrations and nothing else. Only the ACTIVE
# gateway's credentials are a boot requirement; a retired gateway's credentials
# just need to stay set, or its rows fail one at a time (at error,
# `mandate_provider_unavailable`) while every other gateway bills normally.
# Which provider environment we point at. NOT derivable from NODE_ENV: the image
# runs NODE_ENV=production on BOTH stage and prod, so it cannot distinguish
# "stage against the sandbox" from "prod against live money".
PAYMENT_ENV=staging
# All four are REQUIRED when PAYMENT_PROVIDER=decentro (env.ts hard-fails boot
# otherwise). v3 authenticates on client_id + client_secret alone — there is no
# module_secret in this API version.
# DECENTRO_BASE_URL=https://staging.decentro.tech
# DECENTRO_CLIENT_ID=your-client-id
# DECENTRO_CLIENT_SECRET=your-client-secret
# DECENTRO_CONSUMER_URN=your-consumer-urn
# DECENTRO_TIMEOUT_MS=10000

# Razorpay UPI Autopay (Recurring Payments / "CAW" route — NOT the Subscriptions
# API, which runs Razorpay's own cron and would double-schedule every cycle).
# All four are REQUIRED when `razorpay` is the active provider (env.ts hard-fails
# boot otherwise). When it is not active they are not a boot requirement — but
# without them Razorpay's own mandates cannot be billed and its webhooks 401.
#
# THERE IS NO SANDBOX HOST. api.razorpay.com serves both, and test-vs-live is
# decided ENTIRELY by the rzp_test_ / rzp_live_ prefix on the key id — so the
# "am I pointed at prod?" guard reads the KEY, never the URL. env.ts enforces the
# match against PAYMENT_ENV: a live key under PAYMENT_ENV=staging fails the boot
# (it would charge real people during QA), and a test key under
# PAYMENT_ENV=production fails it too. NEVER commit a real value.
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# RAZORPAY_KEY_ID=rzp_test_your-key-id
# RAZORPAY_KEY_SECRET=your-key-secret
# Webhook signing key from the Razorpay dashboard. Razorpay ALWAYS issues one, so
# unlike Cashfree there is no unverified posture: an unset secret REJECTS every
# callback (401) rather than waving it through. The scheme is its own —
# hex(HMAC_SHA256(secret, RAW body)) in X-Razorpay-Signature, with no timestamp —
# so it is not Cashfree's base64(HMAC(timestamp + rawBody)).
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# RAZORPAY_TIMEOUT_MS=10000

# Callback auth. Decentro's India v3 callbacks carry NO HMAC signature, so this
# static token + an IP allowlist + confirm-by-polling is the entire defence.
# min 32 chars: it is a bearer credential on a PUBLIC, unauthenticated route.
# Required when PAYMENT_PROVIDER=decentro. NEVER commit a real value.
# PAYMENT_CALLBACK_TOKEN=generate-a-long-random-string-at-least-32-chars
# PAYMENT_CALLBACK_HEADER=x-prabhuji-callback-token
# Comma-separated IPv4 CIDRs. EMPTY = no IP check — the provider publishes no
# stable egress ranges, and an allowlist that silently drops every callback is a
# worse failure than not having one. The module warns at boot when it is empty.
# PAYMENT_CALLBACK_IP_ALLOWLIST=203.0.113.0/24,198.51.100.7/32

# Acknowledge-first callbacks (TAM-260). Listed gateways get their 200 as soon as
# the webhook_events row commits and are processed after by an in-process worker.
# Unset or EMPTY = every gateway processed inline, exactly as before (the default,
# and the rollback). Unknown names fail the boot.
# PAYMENT_CALLBACK_DEFERRED_PROVIDERS=razorpay
# Rows the worker processes at once, per API task.
# PAYMENT_CALLBACK_WORKER_CONCURRENCY=4
# Claim lease; must exceed the slowest processing run, or a live row is re-claimed.
# PAYMENT_CALLBACK_LEASE_MS=600000
# Re-driver poll period.
# PAYMENT_CALLBACK_REDRIVE_INTERVAL_MS=15000
# Claims a row may take before it is marked failed (the billing sweep is its backstop).
# PAYMENT_CALLBACK_MAX_ATTEMPTS=5

# How long a mandate approval link stays valid (provider caps at 1440).
PAYMENT_MANDATE_EXPIRY_MINUTES=15
# Shown to the user inside their UPI app when approving.
PAYMENT_MANDATE_NAME=Prabhuji VIP Membership

# The recurring-debit scheduler (apps/api/src/billing.ts, run as a one-off ECS
# task by EventBridge every 30 min). Default OFF so no environment starts
# debiting as a side effect of a deploy — turn it on deliberately, after a dry
# run (`node apps/api/dist/billing.js --dry-run`, which is read-only).
ENABLE_BILLING_SCHEDULER=false
# Escape hatch for an unresolved provider question: if Decentro's
# `is_managed_by_decentro` turns out to mean THEY fire the pre-debit
# notification and presentation, ours must stop — both firing is a double
# charge. Cannot be true at the same time as ENABLE_BILLING_SCHEDULER.
PAYMENT_MANDATE_MANAGED_BY_PROVIDER=false

# --- Horoscope daily-content generation (core/horoscope) ---------------------
# The AI content pipeline. With this OFF the horoscope module behaves exactly as
# it did before it existed: a reading with no stored row is a 404, no key is
# read and no model is ever called. Default OFF so no environment starts
# spending on an LLM as a side effect of a deploy.
#
# With it ON, the first request for a sign on a given IST day generates all
# eight sections in all four languages (en/hi/mr/te) in ONE call, checks the
# response SHAPE and runs the content-safety deny-list, then stores four
# `daily_horoscope_result` rows. Subsequent requests read from Postgres. The
# free zodiac-grid call also warms missing signs in the background, which is
# what keeps the first user of the day off the cold path.
#
# 12 calls a day: single-digit dollars a month at any model tier.
# Daily-horoscope generation is switched on by the PRESENCE of this key: set it
# and generation runs; leave it unset and the daily endpoint 404s (no flag).
# NEVER commit a real value.
# OPENAI_API_KEY=sk-...
# Requests go through our LiteLLM gateway, not api.openai.com — same OpenAI wire
# protocol, but the gateway holds the upstream provider key and owns routing and
# spend limits, so OPENAI_API_KEY above is a GATEWAY key. Override to
# https://api.openai.com/v1 to talk to OpenAI directly with an OpenAI key.
OPENAI_BASE_URL=https://prod-litellm-deployment-config-48788246490.asia-south1.run.app
# Must name a model the GATEWAY has allow-listed for the key above — anything
# else 401s ("key not allowed to access model"). Model quality in Marathi and
# Telugu should drive this, not price.
OPENAI_MODEL=gpt-5-nano
# One call returns ~2.5k output tokens across four languages, so this is far
# more generous than the payment-provider timeout.
OPENAI_TIMEOUT_MS=60000
# How long GET /horoscope/daily waits on an in-flight generation before
# returning "being prepared". Bounds the USER's spinner only — generation keeps
# running in the background either way, so their retry finds finished content.
HOROSCOPE_GENERATION_WAIT_MS=10000

# --- Analytics warehouse (ClickHouse Cloud) ---
# TWO readers, both optional — the serving API boots and stays healthy with all
# of these blank, so leaving them unset locally is normal:
#   1. TAM-175 deity-preference sync (apps/api/src/scripts/sync-deity-preferences.ts)
#      — source table <CLICKHOUSE_DATABASE>.custom_user_properties. The feed
#      itself serves from the Postgres mirror, never from here.
#   2. TAM-256 admin status-performance page — reads <CLICKHOUSE_DATABASE>.saas_events
#      LIVE on the admin request path. Unset => the page shows an explicit
#      "not configured" state; it must never 500 or block boot.
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# No default, EVER — each environment reads its OWN warehouse database (stage:
# staging, prod: production). Defaulting would let a stage task silently mirror
# production users' preferences. NOTE it is `production`, not `prod`: the `prod`
# database exists but is empty, and apps/events/db/migrate.ts still targets it
# (TAM-257).
CLICKHOUSE_DATABASE=
# The saas_events.tenant predicate (TAM-256). Also no default: it separates
# "our numbers" from "everyone's numbers" once a second tenant exists.
CLICKHOUSE_TENANT=prabhuji

# TAM-175 master switch for the deity-split feed (home + status + chip row).
# Default false: the code ships dark and every surface serves the
# unpersonalised order until this is "true", whatever the mirror holds.
ENABLE_DEITY_SPLIT=false
