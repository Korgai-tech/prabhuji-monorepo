{
  "name": "monorepo-boilerplate",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "pnpm --filter api exec prisma generate",
    "verify": "pnpm check:arch-boundaries && pnpm check:openapi && pnpm check:media-targets && pnpm check:entitlement-single-read && pnpm nx run-many -t typecheck lint test --exclude=mobile",
    "verify:mobile": "pnpm nx lint mobile && pnpm nx test mobile && pnpm check:analytics && pnpm check:no-hex-literals && pnpm check:figma-tokens-committed",
    "check:analytics": "bash scripts/analytics-audit.sh",
    "check:no-hex-literals": "bash scripts/no-hex-literals.sh",
    "check:figma-tokens-committed": "bash scripts/figma-tokens-committed.sh",
    "seed": "pnpm --dir apps/api run seed",
    "deploy:local": "bash scripts/local-deploy.sh",
    "deploy:infra": "bash scripts/deploy-infra.sh",
    "e2e:web": "bash scripts/e2e-web.sh",
    "e2e:android": "pnpm nx e2e mobile",
    "figma:export": "tsx tools/figma-export.ts",
    "check:arch-boundaries": "tsx scripts/architecture-integrity-check.ts",
    "openapi:emit": "tsx --tsconfig apps/api/tsconfig.app.json apps/api/scripts/emit-openapi.ts",
    "check:openapi": "tsx --tsconfig apps/api/tsconfig.app.json apps/api/scripts/check-openapi.ts",
    "check:media-targets": "node scripts/check-media-targets.mjs",
    "check:entitlement-single-read": "node scripts/check-entitlement-single-read.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "23.0.1",
    "@nx/eslint": "^23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/node": "23.0.1",
    "@nx/react": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/web": "23.0.1",
    "@openapitools/openapi-generator-cli": "^2.39.1",
    "@playwright/test": "^1.61.1",
    "@repo/eslint-config": "workspace:*",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/vite": "^4.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^27.1.0",
    "nx": "23.0.1",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "testcontainers": "^12.0.4",
    "tslib": "^2.3.0",
    "tsx": "latest",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@repo/api-client": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.9.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.22.0",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
